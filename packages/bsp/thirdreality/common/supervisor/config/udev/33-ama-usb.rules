# Third Reality USB Accessories — udev rules
# Creates stable symlinks for AMA USB CDC devices
#
# Install: sudo cp 33-ama-usb.rules /etc/udev/rules.d/
#          sudo udevadm control --reload-rules

# NightLight (PID=0118)
SUBSYSTEM=="tty", ATTRS{idVendor}=="31b6", ATTRS{idProduct}=="0118", \
    SYMLINK+="tr_nightlight", MODE="0666", \
    TAG+="systemd", ENV{SYSTEMD_WANTS}="supervisor.service"

# PIR Motion Sensor (PID=0120)
SUBSYSTEM=="tty", ATTRS{idVendor}=="31b6", ATTRS{idProduct}=="0120", \
    SYMLINK+="tr_pir", MODE="0666", \
    TAG+="systemd", ENV{SYSTEMD_WANTS}="supervisor.service"

# Clock Display (PID=0122)
SUBSYSTEM=="tty", ATTRS{idVendor}=="31b6", ATTRS{idProduct}=="0122", \
    SYMLINK+="tr_clock", MODE="0666", \
    TAG+="systemd", ENV{SYSTEMD_WANTS}="supervisor.service"
