[Unit]
Description=Supervisor Device Management Service (C Version)
Documentation=https://github.com/thirdreality/linuxbox-supervisor
# Wait for network and critical system services to be ready
After=network.target network-online.target NetworkManager.service dbus.service systemd-udevd.service
Wants=network-online.target
# Start before Home Assistant (if present)
Before=home-assistant.service zigbee2mqtt.service otbr-agent.service

[Service]
Type=simple
ExecStart=/usr/local/bin/supervisor --daemon --html /usr/share/hubv3-supervisor/static

# Pre-start preparation
# 1. Ensure log directory exists
ExecStartPre=/bin/sh -c 'mkdir -p /var/log'
# 2. Ensure config directory exists
ExecStartPre=/bin/sh -c 'mkdir -p /var/lib/hubv3-supervisor'
# 3. Rotate log: rename existing supervisor.log to supervisor.log.1 before start
ExecStartPre=/bin/sh -c 'if [ -f /var/log/supervisor.log ]; then mv /var/log/supervisor.log /var/log/supervisor.log.1; fi'
# 4. Check GPIO device readiness (optional, avoids startup failure)
ExecStartPre=/bin/sh -c 'test -e /dev/gpiochip0 || echo "WARNING: GPIO device not ready"'

# Restart policy
Restart=on-failure
RestartSec=5
StartLimitInterval=200
StartLimitBurst=5

# Run as root (required for GPIO, serial port and other hardware access)
User=root
Group=root

# Working directory (created by ExecStartPre if missing)
WorkingDirectory=/var/lib/hubv3-supervisor

# Environment variables
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="SUPERVISOR_LOG=/var/log/supervisor.log"

# Resource limits
LimitNOFILE=65536
LimitNPROC=512
LimitMEMLOCK=infinity

# Logging
# C version has built-in log rotation; output also goes to systemd journal
StandardOutput=journal
StandardError=journal
SyslogIdentifier=supervisor

# Security hardening (optional, adjust as needed)
# Note: Some restrictions cannot be enabled due to hardware device access
# NoNewPrivileges=true
# PrivateTmp=true
# The following options restrict hardware access and are not recommended:
# ProtectSystem=strict
# ProtectHome=true
# ReadWritePaths=/var/lib/hubv3-supervisor /var/log /dev/gpiochip0 /dev/gpiochip1 /dev/ttyUSB0

[Install]
WantedBy=multi-user.target
