+ static struct mmc_command *meson_mmc_get_next_command(struct mmc_command *cmd)
+ {
+	 if (cmd->opcode == MMC_SET_BLOCK_COUNT && !cmd->error)
+		 return cmd->mrq->cmd;
+	 else if (mmc_op_multi(cmd->opcode) &&
+		  (!cmd->mrq->sbc || cmd->error || cmd->data->error))
+		 return cmd->mrq->stop;
+	 else
+		 return NULL;
+ }
