+ static unsigned int meson_mmc_get_timeout_msecs(struct mmc_data *data)
+ {
+	 unsigned int timeout = data->timeout_ns / NSEC_PER_MSEC;
+ 
+	 if (!timeout)
+		 return SD_EMMC_CMD_TIMEOUT_DATA;
+ 
+	 timeout = roundup_pow_of_two(timeout);
