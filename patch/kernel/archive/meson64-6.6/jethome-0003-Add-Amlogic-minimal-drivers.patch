+int pwm_double_channel_conf_dt(struct wifi_plat_info *plat)
+{
+	 phandle pwm_phandle;
+	 int ret;
+	 struct device_node *wifinode = plat->dev->of_node;
+	 struct device_node *pnode = NULL;
+	 struct device_node *child;
+
+	 pr_info("wifi: pwm_double_channel_conf_dt() start\n");
+
+	 ret = of_property_read_u32(wifinode, "pwm_config", &pwm_phandle);
+	 if (ret) {
+		 pr_err("wifi: not match wifi_pwm_config node, ret=%d\n", ret);
+		 return -1;
+	 }
+	 pr_info("wifi: found pwm_config phandle=0x%x\n", pwm_phandle);
+ 
+	 pnode = of_find_node_by_phandle(pwm_phandle);
+	 if (!pnode) {
+		 pr_err("wifi: can't find wifi_pwm_config node\n");
+		 return -1;
+	 }
+	 pr_info("wifi: found pwm_config node: %s\n", pnode->name);
+
+	 /*request for pwm device */
+	 for_each_child_of_node(pnode, child) {
+		 struct pwm_double_data *pdata =
+			 &plat->ddata.pwms[plat->ddata.num_pwm];
+
+		 pr_info("wifi: requesting PWM%d from child node: %s\n",
+			 plat->ddata.num_pwm, child->name);
+		 pdata->pwm = devm_fwnode_pwm_get(plat->dev, of_fwnode_handle(child), NULL);
+		 if (IS_ERR(pdata->pwm)) {
+			 ret = PTR_ERR(pdata->pwm);
+			 dev_err(plat->dev, "wifi: unable to request PWM%d, ret = %d\n",
+				 plat->ddata.num_pwm, ret);
+			 return ret;
+		 }
+		 pr_info("wifi: PWM%d request successful\n", plat->ddata.num_pwm);
+		 ret = of_property_read_u32(child, "duty-cycle",
+						&pdata->duty_cycle);
+		 if (ret) {
+			 pr_err("not %d duty_cycle parameters\n",
+					plat->ddata.num_pwm);
+			 return ret;
+		 }
+		 ret = of_property_read_u32(child, "times",
+						&pdata->pwm_times);
+		 if (ret) {
+			 pr_err("not %d pwm_times parameters\n",
+					plat->ddata.num_pwm);
+			 return ret;
+		 }
+		 plat->ddata.num_pwm++;
+	 }
+	 WIFI_INFO("wifi pwm dt ok\n");
+ 
+	 return 0;
+ }
