+		 }
+		 if (wifi_info.power_on_pin2) {
+			 ret = set_power2(1);
+			 if (ret)
+				 WIFI_INFO("power2 up failed(%d)\n", ret);
+		 }
+		 sdio_reinit();
+	 } else {
+		 if (wifi_info.power_on_pin) {
+			 ret = set_power(0);
+			 if (ret)
+				 WIFI_INFO("power down failed(%d)\n", ret);
+		 }
+		 if (wifi_info.power_on_pin2) {
+			 ret = set_power2(0);
+			 if (ret)
+				 WIFI_INFO("power2 down failed(%d)\n", ret);
+		 }
+	 }
+	 return ret;
+ }
