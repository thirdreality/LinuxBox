+++ b/arch/arm64/boot/dts/amlogic/meson-axg-jethome-jethub-j1xx.dtsi
@@ -16,8 +16,12 @@
 / {
 	aliases {
 		serial0 = &uart_AO;   /* Console */
-		serial2 = &uart_AO_B; /* External UART (Wireless Module) */
+		serial1 = &uart_A; /* UART Bluetooth */
+		serial3 = &uart_AO_B; /* ZigBee */
+		serial6 = &uart_B; /* Thread */
 		ethernet0 = &ethmac;
+		mmc0 = &sd_emmc_c;  /* eMMC - ffe07000 */
+		mmc1 = &sd_emmc_b;  /* SDIO WiFi - ffe05000 */
 	};
 
 	chosen {
@@ -35,14 +39,7 @@ emmc_pwrseq: emmc-pwrseq {
