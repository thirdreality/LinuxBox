+    }
+
+    pdata = (unsigned int *)&testbuf[0];
+     for (i = 0; i < 4096; i += 4) {
+        /*bit6:1 is csi data, 4096 can be changed as uplay buffer*/
+        *pdata = *pdata & 0x0000007e;
+        *buf = *pdata >> 1;
+        buf++;
+        pdata++;
+    }
+    AML_OUTPUT("handle capture data complete\n");
