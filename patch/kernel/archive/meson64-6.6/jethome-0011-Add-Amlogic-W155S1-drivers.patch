+            irq_trigger_type = GPIO_IRQ_HIGH;
+            break;
+        case WIFI_GPIO_IRQ_LOW:
+            irq_trigger_type = GPIO_IRQ_LOW;
+            break;
+        default:
+            ret = -1;
+            goto exit;
+    }
+    do
+    {
+        irq_flag = AML_GPIO_IRQ(irq_num, amlhal_gpio.filter_num, irq_trigger_type);
