+    wifi_mac_pwrsave_vattach(wnet_vif);
+    wifi_mac_com_vattach(wnet_vif);
+    wifi_mac_scan_vattach(wnet_vif);
+    wnet_vif_vht_cap_init(wnet_vif);
+    return 1;
