+
+
+#ifdef CONFIG_P2P
+unsigned char p2p_public_action_tmp[][32]=
+{
+    "P2P_GO_NEGO_REQ",
+    "P2P_GO_NEGO_RESP",
+    "P2P_GO_NEGO_CONF",
