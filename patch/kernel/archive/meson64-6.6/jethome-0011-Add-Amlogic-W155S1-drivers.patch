+            (unsigned long long)sta->sta_rstamp, sta->sta_listen_intval, sta->sta_capinfo);
+    DPRINTF(AML_DEBUG_DEBUG,"\tbssid %s essid \"%.*s\" channel %u:0x%x\n",
