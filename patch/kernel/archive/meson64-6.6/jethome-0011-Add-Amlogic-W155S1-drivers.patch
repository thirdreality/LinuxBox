+
+unsigned int wifi_mac_mhz2chan(unsigned int freq)
+{
+    unsigned int  chan = 1;
+
+    if (freq>5000) {
+        chan = (freq - 5000) / (5);
+
+    } else if ((freq > 2407) && (freq < 2484)) {
+        chan = (freq - 2407) / 5;
+
+    } else if (freq == 2484) {
+        chan = 14;
+
+    } else {
+        ASSERT(0);
+    }
+
+    return chan;
+}
