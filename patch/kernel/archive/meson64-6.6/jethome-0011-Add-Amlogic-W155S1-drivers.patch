+        (wnet_vif->vm_opmode == WIFINET_M_IBSS))
+    {
+        drv_tx_get_mgmt_frm_rate(drv_priv, wnet_vif,
+            WIFINET_FC0_TYPE_MGT | WIFINET_FC0_SUBTYPE_BEACON, &rate, &flag);
