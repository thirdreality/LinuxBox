+static __inline int
+wifi_mac_hdrspace(struct wifi_mac *wifimac, const void *data)
+{
+    int size = wifi_mac_hdrsize(data);
+    if (wifimac->wm_flags & WIFINET_F_DATAPAD)
+        size = roundup(size, sizeof(unsigned int));
+    return size;
+}
