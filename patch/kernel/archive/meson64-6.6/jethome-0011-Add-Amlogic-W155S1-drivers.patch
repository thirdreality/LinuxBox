+static int hal_get_chip_id(void)
+{
+    int ret = false;
+#ifdef CONFIG_MAC_SUPPORT
+    unsigned int chip_id_l = 0;
+    unsigned int chip_id_h = 0;
+    unsigned char chip_id_buf[23];
+
+    chip_id_l = efuse_manual_read(CHIP_ID_EFUASE_L);
