+    if (wnet_vif == NULL)
+        return NULL;
+
+    nt =  &wnet_vif->vm_sta_tbl;
+    if (WIFINET_IS_CRTL(wh) && !WIFINET_IS_PSPOLL(wh) && !WIFINET_IS_BAR(wh))
