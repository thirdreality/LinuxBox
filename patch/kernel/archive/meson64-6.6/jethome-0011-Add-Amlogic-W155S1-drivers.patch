+{
+    if (our_txpriv_pool.min_count > num)
+    {
+        //printk("---xman debug: the min_count is :%d.\n",our_txpriv_pool.min_count);
+        return 1;
+    }
+    else
+    {
+        printk("---xman debug: the min_count is :%d.\n",our_txpriv_pool.min_count);
+        return 0;
+    }
+}
