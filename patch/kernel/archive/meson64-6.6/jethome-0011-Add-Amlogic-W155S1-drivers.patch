+            cipher = WIFINET_CIPHER_AES_CCM;
+            break;
+        case WLAN_CIPHER_SUITE_AES_CMAC:
+            cipher = WIFINET_CIPHER_AES_CMAC;
+            break;
+        default:
+            cipher = -ENOTSUPP;
+    }
+    return cipher;
+}
