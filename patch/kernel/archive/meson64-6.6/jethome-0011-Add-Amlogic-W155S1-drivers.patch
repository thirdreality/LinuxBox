+
+        aml_w1_sdio_write_word(RG_INTF_CPU_CLK, 0x4f070001);
+
+        reg_aon29_data.data = aml_w1_sdio_read_word(RG_AON_A29);
+        reg_aon29_data.b.rg_ana_bpll_cfg |= BIT(1) | BIT(0);
