+int platform_wifi_request_gpio_irq (void *data)
+{
+    unsigned int irq_num = wifi_irq_num();
+    int ret = -1;
+    int irq_trigger_type, irq_flag;
+
+    irq_flag = IRQF_DISABLED;
+    amlhal_gpio.gpio_irq_mode = wifi_irq_trigger_level();
