+unsigned int process_cali_content(char *varbuf, unsigned int len)
+{
+    char *dp;
+    bool findNewline;
+    int column;
+    unsigned int buf_len, n;
+    unsigned int pad = 0;
+
+    dp = varbuf;
+    findNewline = false;
+    column = 0;
+
+    for (n = 0; n < len; n++) {
+        if (varbuf[n] == '\r')
+            continue;
+
+        if (findNewline && varbuf[n] != '\n')
+            continue;
+        findNewline = false;
+        if (varbuf[n] == '#') {
+            findNewline = true;
+            continue;
+        }
+        if (varbuf[n] == '\n') {
+            if (column == 0)
+                continue;
+            *dp++ = 0;
+            column = 0;
+            continue;
+        }
+        *dp++ = varbuf[n];
+        column++;
+    }
+    buf_len = (unsigned int)(dp - varbuf);
+    if (buf_len % 4) {
+        pad = 4 - buf_len % 4;
+        if (pad && (buf_len + pad <= len)) {
+            buf_len += pad;
+        }
+    }
+
+    while (dp < varbuf + n)
+        *dp++ = 0;
+
+    return buf_len;
+}
