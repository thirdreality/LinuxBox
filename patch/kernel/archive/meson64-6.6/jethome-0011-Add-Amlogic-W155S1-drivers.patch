+            p2p_noa_start_irq(wnet_vif->vm_p2p, drv_priv);
+
+        } else if (wnet_vif->vm_pstxqueue_flags & WIFINET_PSQUEUE_NOA) {
+             drv_priv->net_ops->wifi_mac_pwrsave_fullsleep(wnet_vif, SLEEP_AFTER_NOA_START);
