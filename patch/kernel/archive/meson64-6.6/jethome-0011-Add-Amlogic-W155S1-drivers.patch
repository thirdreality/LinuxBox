+void
+wifi_mac_set_shortslottime(struct wifi_mac *wifimac, int onoff)
+{
+
+    if (onoff)
+        wifimac->wm_flags |= WIFINET_F_SHSLOT;
+    else
+        wifimac->wm_flags &= ~WIFINET_F_SHSLOT;
+
+    wifi_mac_updateslot(wifimac);
