+unsigned int wifi_mac_Mhz2ieee(unsigned int freq, unsigned int flags)
+{
+    if (flags & WIFINET_CHAN_2GHZ)
+    {
+        if (freq == 2484)
+            return 14;
+
+        if (freq < 2484)
+            return (freq - 2407) / 5;
+        else
+            return 15 + ((freq - 2512) / 20);
+    }
+    else if (flags & WIFINET_CHAN_5GHZ)
+    {
+        return (freq - 5000) / 5;
+    }
+    else
+    {
+        if (freq == 2484)
+            return 14;
+
+        if (freq < 2484)
+            return (freq - 2407) / 5;
+
+        if (freq < 5000)
+            return 15 + ((freq - 2512) / 20);
+
+        return (freq - 5000) / 5;
+    }
+}
