+    if (changed & WIPHY_PARAM_FRAG_THRESHOLD &&
+        wnet_vif->vm_fragthreshold != wiphy->frag_threshold) {
+        wnet_vif->vm_fragthreshold = wiphy->frag_threshold;
+        printk("vm_fragthreshold: %d\n", wnet_vif->vm_fragthreshold);
