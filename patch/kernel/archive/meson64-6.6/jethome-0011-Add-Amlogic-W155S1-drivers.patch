+int hal_calc_mpdu_page (int mpdulen)
+{
+    return howmanypage(mpdulen+FW_TXDESC_DATAOFFSET, PAGE_LEN);
+}
+
+int hal_calc_block_in_mpdu (int mpdulen)
+{
+    return (mpdulen + (PAGE_LEN - 1)) / PAGE_LEN;
+}
