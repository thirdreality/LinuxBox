+void vm_p2p_scanend(struct wifi_mac_p2p *p2p)
+{
+    vm_p2p_set_state(p2p, NET80211_P2P_STATE_IDLE);
+    p2p->social_channel = 0;
+    AML_PRINT(AML_DBG_MODULES_P2P,"++\n");
