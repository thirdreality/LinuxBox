+int hal_is_empty_tx_id(struct hal_private * hal_priv)
+{
+    unsigned char id =0;
+
+    while(id < WIFI_MAX_TXFRAME)
+    {
+        if(test_bit(id, hal_priv->tx_frames_map))
+        {
+            return -1;
+        }
+        id++;
