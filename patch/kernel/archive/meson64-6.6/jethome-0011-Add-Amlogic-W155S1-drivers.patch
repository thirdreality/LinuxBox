+#ifndef _AML_DEBUG_H_
+#define _AML_DEBUG_H_
+
+#include <linux/bitops.h>
+#include <linux/kernel.h>
+
+#ifndef BIT
+#define BIT(n)    (1UL << (n))
+#endif //BIT
+
+#define  CTRL_BYTE
+#define LINEBYTE 32
+#define ASCII_IN  1
+
+enum
+{
+    AML_DEBUG_ACL              = BIT(0),   /* reset module  */
