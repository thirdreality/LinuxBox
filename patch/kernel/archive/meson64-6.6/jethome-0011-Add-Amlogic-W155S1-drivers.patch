+
+static int aml_ieee80211_chan_to_frq(int chan, int band)
+{
+
+    if (band == IEEE80211_BAND_5GHZ)
+    {
+        if (chan >= 182 && chan <= 196)
+            return 4000 + chan * 5;
+        else
+            return 5000 + chan * 5;
+    }
+    else
+    {
+        if (chan == 14)
+            return 2484;
+        else if (chan < 14)
+            return 2407 + chan * 5;
+        else
+            return 0;
+    }
+}
