+#ifndef _NET80211_IEEE80211_NODE_H_
+#define _NET80211_IEEE80211_NODE_H_
+
+#include <asm/byteorder.h>
+#ifdef CONFIG_NET_WIRELESS
+#include <linux/wireless.h>
