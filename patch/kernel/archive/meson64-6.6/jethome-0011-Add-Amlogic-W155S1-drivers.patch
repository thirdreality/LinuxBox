+/*skb_pull*/
+static void * OS_SKBBUF_PULL(struct sk_buff * skb, unsigned int len )
+{
+        skb->data_len -= len;
+        skb->data+=len;
+        return skb->data;
+}
+/*skb_put*/
+static void * OS_SKBBUF_PUT(struct sk_buff * skb, unsigned int len )
+{
