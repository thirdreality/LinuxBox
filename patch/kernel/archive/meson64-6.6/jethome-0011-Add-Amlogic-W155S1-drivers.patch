+        return -ENOMEM;
+    }
+#endif
+    aml_w1_sdio_init();
+    printk("%s(%d) start...\n",__func__, __LINE__);
+    return 0;
+}
+
+static void aml_w1_sdio_rmmod(void)
+{
+    aml_w1_sdio_exit();
+}
