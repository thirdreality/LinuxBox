+    if ((stopaddr <= TBC_ADDR_BEGIN_OFFSET) || (stopaddr >= TBC_ADDR_END_OFFSET)) {
+        ERROR_DEBUG_OUT("stopaddr=0x%x out of capture range\n", stopaddr);
