+    }
+
+    sta->sta_ap_quiet_md = vht_quiet_chn->ap_quiet_md;
+    sta->sta_quiet_cnt = vht_quiet_chn->quiet_cnt;
+    sta->sta_quiet_prd = vht_quiet_chn->quiet_prd;
