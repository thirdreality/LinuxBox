+static void clk_source_select(int IS_SSV_CLK)
+{
+    int gpio_clk_sel = amlhal_gpio.clk_sel;
+    int ret = 0;
+    int gpio = 0;
+
+    ret = gpio_request(gpio_clk_sel,  OWNER_NAME);
