+void    wifi_mac_parse_vht_quiet_ch(struct wifi_station *sta, unsigned char *ie)
+{
+    struct wifi_mac_ie_vht_quiet_chn* vht_quiet_chn = (struct wifi_mac_ie_vht_quiet_chn*)ie;
+    if (vht_quiet_chn == NULL || sta ==  NULL) {
+        return;
