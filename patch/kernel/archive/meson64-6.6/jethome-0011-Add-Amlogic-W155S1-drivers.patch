+int drv_rate_findindex_from_ratecode(const struct drv_rate_table *rt, int vendor_rate_code)
+{
+    int i;
+
+    for (i = 0; i < rt->rateCount; i++) {
+        if (rt->info[i].vendor_rate_code == vendor_rate_code) {
+            break;
+        }
+    }
+
+    return i;
+}
