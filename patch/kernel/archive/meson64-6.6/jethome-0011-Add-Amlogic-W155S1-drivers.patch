+#endif
+    wnet_vif->vm_pwrsave.ips_sleep_wait_reason = SLEEP_NONE;
+    WIFINET_PWRSAVE_UNLOCK(wnet_vif);
+    WIFINET_NODE_LOCK_DESTROY(&wnet_vif->vm_pwrsave);
