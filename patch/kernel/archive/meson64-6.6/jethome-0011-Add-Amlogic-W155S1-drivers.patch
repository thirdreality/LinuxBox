+unsigned short Hal_TxDescriptor_GetAckTimeout( unsigned char data_rate,unsigned char preambletype)
+{
+    if (IS_HT_RATE(data_rate) || IS_VHT_RATE(data_rate)) {
+        return 80 + PHY_TEST;
+    } else {
+        return 20 + PHY_TEST;
+    }
+}
