From d8ef7ad5960e793b7efeb9a1e7e802c640f8b263 Mon Sep 17 00:00:00 2001
From: "guoping.liu" <guoping.liu@3reality.com>
Date: Thu, 12 Feb 2026 11:17:14 +0800
Subject: [PATCH] add arm64 dts trhub-v3a (512M/1G, no ttyAML6, uart_AO_B 
 pins)

---
 arch/arm64/boot/dts/amlogic/Makefile          |  1 +
 .../meson-axg-thirdreality-trhub-v3a.dts      | 89 +++++++++++++++++++
 2 files changed, 90 insertions(+)
 create mode 100644 arch/arm64/boot/dts/amlogic/meson-axg-thirdreality-trhub-v3a.dts

diff --git a/arch/arm64/boot/dts/amlogic/Makefile b/arch/arm64/boot/dts/amlogic/Makefile
index 164eac98ecb1..f55f51f6e50e 100644
--- a/arch/arm64/boot/dts/amlogic/Makefile
+++ b/arch/arm64/boot/dts/amlogic/Makefile
@@ -7,6 +7,7 @@ dtb-$(CONFIG_ARCH_MESON) += meson-axg-jethome-jethub-j100.dtb
 dtb-$(CONFIG_ARCH_MESON) += meson-axg-jethome-jethub-j110-rev-2.dtb
 dtb-$(CONFIG_ARCH_MESON) += meson-axg-jethome-jethub-j110-rev-3.dtb
 dtb-$(CONFIG_ARCH_MESON) += meson-axg-thirdreality-trhub-v3.dtb
+dtb-$(CONFIG_ARCH_MESON) += meson-axg-thirdreality-trhub-v3a.dtb
 dtb-$(CONFIG_ARCH_MESON) += meson-axg-thirdreality-trhub-v3b.dtb
 # dtb-$(CONFIG_ARCH_MESON) += meson-axg-s400.dtb
 # dtb-$(CONFIG_ARCH_MESON) += meson-g12a-radxa-zero.dtb
diff --git a/arch/arm64/boot/dts/amlogic/meson-axg-thirdreality-trhub-v3a.dts b/arch/arm64/boot/dts/amlogic/meson-axg-thirdreality-trhub-v3a.dts
new file mode 100644
index 000000000000..ae97bca8c1e8
--- /dev/null
+++ b/arch/arm64/boot/dts/amlogic/meson-axg-thirdreality-trhub-v3a.dts
@@ -0,0 +1,89 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
+/*
+ * Copyright (c) 2022 Vyacheslav Bocharov <adeep@lexina.in>
+ * Copyright (c) 2022 JetHome
+ * Author: Vyacheslav Bocharov <adeep@lexina.in>
+ */
+
+/dts-v1/;
+
+#include "meson-axg-jethome-jethub-j1xx.dtsi"
+
+/ {
+	compatible = "ThirdReality,trhub-v3a", "amlogic,a113d", "amlogic,meson-axg";
+	model = "ThirdReality TRHub-V3A";
+
+	/* No serial6 (Thread UART) on this variant */
+	aliases {
+		/delete-property/ serial6;
+	};
+
+	/* 512MB RAM; for 1GB use reg = <0x0 0x0 0x0 0x40000000> */
+	memory@0 {
+		device_type = "memory";
+		reg = <0x0 0x0 0x0 0x40000000>;
+	};
+
+	/* Amlogic Bluetooth controller */
+	aml_bt: aml_bt {
+		compatible = "amlogic, aml-bt";
+		status = "okay";
+	};
+
+	aml_wifi: aml_wifi {
+		compatible = "amlogic, aml-wifi";
+		status = "okay";
+		irq_trigger_type = "IRQF_TRIGGER_LOW";
+		//dhd_static_buf; /* if use bcm wifi, config dhd_static_buf */
+		//pinctrl-0 = <&pwm_e_pins>;
+		//pinctrl-names = "default";
+		pwm_config = <&wifi_pwm_conf>;
+		//pwm_config = <&sdio_pwrseq>;
+	};
+
+	
+	wifi_pwm_conf:wifi_pwm_conf{
+		pwm_channel1_conf {
+			pwms = <&pwm_AO_cd 0 30541 0>;
+			duty-cycle = <15270>;
+			times = <10>;
+		};
+		
+		pwm_channel2_conf {
+			pwms = <&pwm_AO_cd 2 30500 0>;
+			duty-cycle = <15250>;
+			times = <12>;
+		};
+	};
+};
+
+/* wifi module */
+&sd_emmc_b {
+	broken-cd;/* cd-gpios = <&gpio_ao GPIOAO_3 GPIO_ACTIVE_LOW>;*/
+};
+
+&aml_wifi{
+	status = "okay";
+	interrupt-gpios = <&gpio  GPIOX_6  GPIO_ACTIVE_HIGH>;
+	power_on-gpios = <&gpio   GPIOX_7  GPIO_ACTIVE_HIGH>;
+	//power_on_2-gpios= <&gpio  GPIOX_16 GPIO_ACTIVE_HIGH>;
+};
+
+&aml_bt {
+	status = "okay";
+	reset-gpios = <&gpio    GPIOX_21 GPIO_ACTIVE_HIGH>;
+	btwakeup-gpios = <&gpio GPIOZ_6 GPIO_ACTIVE_HIGH>; /* BT_WAKE_HOST: W1 pin50 out -> SoC in; bt_device.c sets input + request_irq */
+	hostwake-gpios = <&gpio GPIOZ_7 GPIO_ACTIVE_HIGH>; /* HOST_WAKE_BT: SoC out -> W1 pin49 in; bt_device.c sets output 1 */
+};
+
+/* V3A: uart_AO_B uses uart_ao_b_pins (not uart_ao_b_z_pins) */
+&uart_AO_B {
+	status = "okay";
+	pinctrl-0 = <&uart_ao_b_pins>;
+	pinctrl-names = "default";
+};
+
+/* No Thread UART on V3A */
+&uart_B {
+	status = "disabled";
+};
-- 
