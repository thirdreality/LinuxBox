From: ThirdReality <dev@3reality.com>
Subject: [PATCH] mmc: meson-gx: export sdio_reinit() for the W155S1 glue on
 the mainline host driver

Replaces the Amlogic 5.x meson-gx-mmc.c / mmc core swap that jethome-0003
used to carry.  The mainline host driver is kept as is; only the two entry
points the out-of-tree Amlogic WiFi/BT code needs are added on top of it.

meson-gx-mmc.c:
  - Remember the first registered host that is not "no-sdio" (on the TRHub
    boards that is sd_emmc_b, the W155S1 slot) and forget it on remove.
  - sdio_host_is_ready(): lets wifi_dt defer its probe until that host has
    registered.
  - sdio_reinit(): if a card is already bound, reset it through the
    exported mmc_sw_reset() (SDIO bus_ops->sw_reset: CMD52 IO reset, go
    idle, re-init at f_init).  Otherwise clear rescan_entered, which gates
    non-removable hosts to a single scan, and run mmc_detect_change() plus
    flush_delayed_work() so the caller returns after the scan finished.
    This is what the vendor 6.6 common_drivers tree does as well; no mmc
    core internals (sdio_reset_comm, mmc_sdio_init_card, ...) are used.

wifi_dt.c / wifi_dt.h:
  - Defer aml_wifi probe until the SDIO host is registered.  If wifi_dt
    powers the chip first, its sdio_reinit() calls find no host, and the
    host's own first rescan then lands while the chip is powered but not
    answering; with the old vendor host driver that wedged mmc_rescan
    (measured: 80 PASS all had the host probing before 0.34 s, 3 FAIL at
    0.85-0.88 s).  Keeping the ordering deterministic is still the right
    thing with the mainline host.
  - Declare sdio_reinit()/sdio_host_is_ready() in wifi_dt.h instead of
    pulling in the vendor aml_sd.h, which is no longer shipped.

The IRQ "ack before NULL check" half of the previous version of this patch
is dropped: it patched the vendor host's hard-IRQ completion path, which no
longer exists.  Mainline acks before dereferencing host->cmd already.

Behaviour change worth stating: if the SDIO host never probes, aml_wifi now
stays deferred instead of powering the chip with nothing to enumerate it.
---
 drivers/amlogic/wifi/wifi_dt.c  | 13 ++++++++++-
 drivers/mmc/host/meson-gx-mmc.c | 50 +++++++++++++++++++++++++++++++++++++++++
 include/linux/amlogic/wifi_dt.h |  6 +++++
 3 files changed, 68 insertions(+), 1 deletion(-)

diff --git a/drivers/amlogic/wifi/wifi_dt.c b/drivers/amlogic/wifi/wifi_dt.c
index 097cb3737a819c5ce6bf8c0e6dc2b4b48b70c626..ec1ef973e2759558635ca7996e25044fabb341a8 100644
--- a/drivers/amlogic/wifi/wifi_dt.c
+++ b/drivers/amlogic/wifi/wifi_dt.c
@@ -38,7 +38,6 @@
 #include <linux/amlogic/pm.h>
  #include <linux/uaccess.h>
  #include <linux/pci.h>
-#include <linux/amlogic/aml_sd.h>
 #include <linux/printk.h>
  #ifdef CONFIG_AMLOGIC_PWM_32K
  #include <linux/pwm.h>
@@ -738,6 +737,18 @@ static int wifi_dev_probe(struct platform_device *pdev)
 	 int ret;
 
 	 pr_info("### wifi_dev_probe: START, device=%s ###\n", dev_name(&pdev->dev));
+	 /*
+	  * Defer until the SDIO host has probed - see sdio_host_is_ready() in
+	  * drivers/mmc/host/meson-gx-mmc.c for why the ordering matters.  Without
+	  * this, on roughly 1 boot in 10 this probe wins the race, its
+	  * sdio_reinit() calls find no host and do nothing, and the SDIO host's
+	  * own first rescan then lands in the window where the chip is powered but
+	  * not yet answering, which wedges mmc_rescan for good and loses wlan0.
+	  */
+	 if (!sdio_host_is_ready()) {
+	 	pr_info("aml_wifi: SDIO host not registered yet, deferring probe\n");
+	 	return -EPROBE_DEFER;
+	 }
 
 #ifdef CONFIG_OF
 	 struct wifi_plat_info *plat;
diff --git a/drivers/mmc/host/meson-gx-mmc.c b/drivers/mmc/host/meson-gx-mmc.c
index 7268946d3894d8eb9bdbcf533153f4e88e0b4498..608ad2070bced0ea19bc51a348a3cdfff192c0a9 100644
--- a/drivers/mmc/host/meson-gx-mmc.c
+++ b/drivers/mmc/host/meson-gx-mmc.c
@@ -15,9 +15,11 @@
 #include <linux/platform_device.h>
 #include <linux/ioport.h>
 #include <linux/dma-mapping.h>
+#include <linux/mmc/card.h>
 #include <linux/mmc/host.h>
 #include <linux/mmc/mmc.h>
 #include <linux/mmc/sdio.h>
+#include <linux/mmc/sdio_func.h>
 #include <linux/mmc/slot-gpio.h>
 #include <linux/io.h>
 #include <linux/clk.h>
@@ -1142,6 +1144,48 @@ static const struct mmc_host_ops meson_mmc_ops = {
 	.ack_sdio_irq	= meson_mmc_ack_sdio_irq,
 };
 
+/* Amlogic out-of-tree WiFi/BT drivers (W155S1) re-enumerate the card through this. */
+static struct mmc_host *sdio_host;
+
+bool sdio_host_is_ready(void)
+{
+	return sdio_host != NULL;
+}
+EXPORT_SYMBOL(sdio_host_is_ready);
+
+void sdio_reinit(void)
+{
+	struct mmc_host *mmc = sdio_host;
+	struct mmc_card *card;
+	struct sdio_func *func = NULL;
+	int i, ret;
+
+	if (!mmc) {
+		pr_info("%s: no SDIO host registered\n", __func__);
+		return;
+	}
+
+	card = mmc->card;
+	if (card) {
+		for (i = 0; i < card->sdio_funcs && !func; i++)
+			func = card->sdio_func[i];
+		if (WARN_ON(!func))
+			return;
+		sdio_claim_host(func);
+		ret = mmc_sw_reset(card);
+		sdio_release_host(func);
+		if (ret)
+			dev_warn(mmc_dev(mmc), "%s: sw reset failed: %d\n", __func__, ret);
+		return;
+	}
+
+	/* non-removable hosts only rescan once unless this is cleared */
+	mmc->rescan_entered = 0;
+	mmc_detect_change(mmc, 0);
+	flush_delayed_work(&mmc->detect);
+}
+EXPORT_SYMBOL(sdio_reinit);
+
 static int meson_mmc_probe(struct platform_device *pdev)
 {
 	struct resource *res;
@@ -1291,6 +1335,9 @@ static int meson_mmc_probe(struct platform_device *pdev)
 	if (ret)
 		goto err_free_irq;
 
+	if (!(mmc->caps2 & MMC_CAP2_NO_SDIO) && !sdio_host)
+		sdio_host = mmc;
+
 	return 0;
 
 err_free_irq:
@@ -1304,6 +1351,9 @@ static void meson_mmc_remove(struct platform_device *pdev)
 {
 	struct meson_host *host = dev_get_drvdata(&pdev->dev);
 
+	if (sdio_host == host->mmc)
+		sdio_host = NULL;
+
 	mmc_remove_host(host->mmc);
 
 	/* disable interrupts */
diff --git a/include/linux/amlogic/wifi_dt.h b/include/linux/amlogic/wifi_dt.h
index 3d3418924fc9ed949007649066aab63ed99962ab..b7e0b2c55a06142c74ef32f44f64a8146388cd8a 100644
--- a/include/linux/amlogic/wifi_dt.h
+++ b/include/linux/amlogic/wifi_dt.h
@@ -6,11 +6,17 @@
 #ifndef _wifi_dt_h_
 #define _wifi_dt_h_
 
+#include <linux/types.h>
+
 void extern_wifi_set_enable(int is_on);
 int wifi_irq_num(void);
 void set_usb_bt_power(int is_power);
 void aml_wifi_chip(const char *type);
 
+/* provided by drivers/mmc/host/meson-gx-mmc.c */
+void sdio_reinit(void);
+bool sdio_host_is_ready(void);
+
 #ifdef CONFIG_PCI
 /*amlogic 4.9 kernel support pci interface wifi*/
 void pci_lock_rescan_remove(void);
-- 
Armbian

