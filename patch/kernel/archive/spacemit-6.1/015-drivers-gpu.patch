+	trace_rogue_sched_switch(pszWorkType, eSwType, ui64HWTimestampInOSTime,
+	                         ui32GpuId, ui32CtxId, 2-ui32CtxPriority, ui32IntJobRef,
+	                         ui32ExtJobRef);
