+#define PDP_BIF_CONTROL1_MMU_FLUSH1_SHIFT		(1)
+#define PDP_BIF_CONTROL1_MMU_FLUSH1_LENGTH		(1)
+#define PDP_BIF_CONTROL1_MMU_FLUSH1_SIGNED_FIELD	IMG_FALSE
