+#define OSFreeAppHintState(state) \
+	PVRSRVFreeAppHintState(IMG_SRV_UM, state)
+
+#endif /* defined(__linux__) */
+
+#endif /* OS_APPHINT_H */
+
+/******************************************************************************
+ End of file (os_apphint.h)
