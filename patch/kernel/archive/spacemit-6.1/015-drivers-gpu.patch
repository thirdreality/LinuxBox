+};
+
+enum i2c_len {
+	I2C_8BIT = 1,
+	I2C_16BIT = 2,
+	I2C_24BIT = 3,
+	I2C_32BIT = 4,
+};
+
+void dptc_dsi_write(uint32_t reg, uint32_t data);
