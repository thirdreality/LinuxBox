+static irqreturn_t spacemit_dpu_isr(int irq, void *data)
+{
+	struct spacemit_dpu *dpu = data;
+	u32 int_mask = 0;
+
+	if (dpu->core && dpu->core->isr)
+		int_mask = dpu->core->isr(dpu);
+
+	if (int_mask & DPU_INT_UNDERRUN)
+		DRM_DEBUG("Warning: dpu underrun!\n");
+
+	return IRQ_HANDLED;
+}
