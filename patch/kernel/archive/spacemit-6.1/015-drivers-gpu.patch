+	uint32_t hbp_pkt_en; /*bit:18*/
+	uint32_t hfp_pkt_en; /*bit:20*/
+	uint32_t hex_pkt_en;
+	uint32_t hlp_pkt_en; /*bit:22*/
+	uint32_t auto_dly_dis;
+	uint32_t timing_check_dis;
+	uint32_t hact_wc_en;
+	uint32_t auto_wc_dis;
+	uint32_t vsync_rst_en;
+};
+
+struct spacemit_mipi_info {
+	unsigned int height;
+	unsigned int width;
